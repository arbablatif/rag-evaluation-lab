# Copy to .env and fill in the key for the provider you use.
# Provider: gemini, anthropic or openai
LLM_PROVIDER=gemini
# Optional model override. Blank uses the provider default.
LLM_MODEL=
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
# Hard cap on real API attempts, counted across runs in .cache/llm/usage.json
MAX_API_CALLS=300
# Minimum seconds between API calls
MIN_CALL_INTERVAL_S=4.5
